    {
      "parameters": {
        "jsCode": "// Demo stand-in for PDF extraction: structured fields representing parsed supplier invoices.\n// To process real PDFs, replace this node with a file intake and Extract from File (PDF) + parsing.\nreturn [\n{customerId:'CUST-101',invoiceId:'INV-001',expenseAmount:4200,currency:'USD',sourceDocument:'supplier_CUST-101.pdf'},\n{customerId:'CUST-102',invoiceId:'INV-002',expenseAmount:1700,currency:'USD',sourceDocument:'supplier_CUST-102.pdf'},\n{customerId:'CUST-103',invoiceId:'INV-003',expenseAmount:5200,currency:'USD',sourceDocument:'supplier_CUST-103.pdf'}\n].map(json=>({json}));"
      },
