      "name": "Merge With PDF Expenses",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        2416,
        768
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({json:x})=>{\n const revenue=Number(x.revenue||0), expense=Number(x.expenseAmount||0);\n const netProfit=Number((revenue-expense).toFixed(2));\n const profitMarginPercent=revenue>0?Number((100*netProfit/revenue).toFixed(2)):0;\n const riskLevel=netProfit<0?'HIGH':profitMarginPercent<20?'MEDIUM':'LOW';\n return {json:{customerId:x.customerId,companyName:x.companyName,accountTier:x.accountTier,industry:x.industry,email:x.email,\n transactionId:x.transactionId,invoiceId:x.invoiceId,sourceDocument:x.sourceDocument,\n financialSummary:{totalRevenue:revenue,totalExpenses:expense,netProfit,profitMarginPercent},riskLevel,syncedAt:new Date().toISOString()}};\n});"
      },
      "id": "639f2dd4-720c-4a95-90d1-fe660120e901",
      "name": "Compute Customer 360 Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2688,
        768
      ]
    },
    {
      "parameters": {
        "jsCode": "const profiles=$input.all().map(i=>i.json);\nreturn [{json:{runId:'SYNC-'+Date.now(),recordCount:profiles.length,profiles,warehouseEndpoint:'https://httpbin.org/post'}}];"
      },
      "id": "4134ea6a-3c40-4dbc-a189-34a4b49f5425",
      "name": "Prepare Warehouse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2928,
        768
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "9c41d865-e6c3-4d58-8745-2dd7158445e8",
      "name": "Post to Mock Warehouse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3184,
        768
      ]
    },
    {
      "parameters": {
        "jsCode": "const sent=$('Prepare Warehouse Payload').first().json;\nconst responses=$input.all().map(i=>i.json);\nconst first=responses[0]||{};\nconst accepted=Boolean(first.json && !first.error);\nreturn [{json:{runId:sent.runId,recordsPrepared:sent.recordCount,warehouseRequestAccepted:accepted,\n status:accepted?'MOCK_SYNC_ACCEPTED':'REVIEW_WAREHOUSE_RESPONSE',\n sourceSystems:['CRM mock','SQL mock','PDF extraction mock'],\n highRiskCustomers:sent.profiles.filter(p=>p.riskLevel==='HIGH').map(p=>p.customerId),\n note:'This is a training demonstration. Source systems and PDF extraction are simulated; httpbin echoes the warehouse POST and does not store data.'}}];"
      },
